{
  "type": "config",
  "title": "microvm",
  "id": "conf.service.microvm",
  "queryinfo": {
    "xpath": "/config/services/microvm",
    "iterable": false
  },
  "properties": {
    "enable": {
      "type": "boolean",
      "default": true
    },
    "sharedfolderref": {
      "type": "string",
      "oneOf": [
        {
          "type": "string",
          "format": "uuidv4"
        },
        {
          "type": "string",
          "maxLength": 0
        }
      ],
      "default": ""
    },
    "install_cterm": {
      "type": "boolean",
      "default": true
    },
    "vms": {
      "type": "object",
      "properties": {
        "vm": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string",
                "format": "uuidv4"
              },
              "name": {
                "type": "string",
                "default": ""
              },
              "enable": {
                "type": "boolean",
                "default": true
              },
              "autostart": {
                "type": "boolean",
                "default": false
              },
              "vcpus": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32,
                "default": 1
              },
              "memory_mib": {
                "type": "integer",
                "minimum": 128,
                "maximum": 65536,
                "default": 512
              },
              "imageref": {
                "type": "string",
                "default": ""
              },
              "networkref": {
                "type": "string",
                "default": ""
              },
              "macaddr": {
                "type": "string",
                "default": ""
              },
              "bootargs": {
                "type": "string",
                "default": "console=ttyS0 reboot=k panic=1 pci=off"
              },
              "notes": {
                "type": "string",
                "default": ""
              }
            }
          }
        }
      }
    },
    "images": {
      "type": "object",
      "properties": {
        "image": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string",
                "format": "uuidv4"
              },
              "name": {
                "type": "string",
                "default": ""
              },
              "arch": {
                "type": "string",
                "default": "x86_64"
              },
              "version": {
                "type": "string",
                "default": ""
              },
              "kernel_path": {
                "type": "string",
                "default": ""
              },
              "rootfs_path": {
                "type": "string",
                "default": ""
              },
              "source_url": {
                "type": "string",
                "default": ""
              },
              "size_bytes": {
                "type": "integer",
                "default": 0
              },
              "imported": {
                "type": "string",
                "default": ""
              }
            }
          }
        }
      }
    },
    "networks": {
      "type": "object",
      "properties": {
        "network": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string",
                "format": "uuidv4"
              },
              "name": {
                "type": "string",
                "default": ""
              },
              "type": {
                "type": "string",
                "enum": ["bridge", "nat"],
                "default": "bridge"
              },
              "bridge": {
                "type": "string",
                "default": ""
              },
              "subnet": {
                "type": "string",
                "default": ""
              },
              "dhcp": {
                "type": "boolean",
                "default": true
              },
              "notes": {
                "type": "string",
                "default": ""
              }
            }
          }
        }
      }
    },
    "disks": {
      "type": "object",
      "properties": {
        "disk": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string",
                "format": "uuidv4"
              },
              "vmref": {
                "type": "string",
                "default": ""
              },
              "name": {
                "type": "string",
                "default": ""
              },
              "sharedfolderref": {
                "type": "string",
                "oneOf": [
                  {
                    "type": "string",
                    "format": "uuidv4"
                  },
                  {
                    "type": "string",
                    "maxLength": 0
                  }
                ],
                "default": ""
              },
              "size_mib": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16777216,
                "default": 1024
              },
              "fstype": {
                "type": "string",
                "enum": ["ext4", "none"],
                "default": "ext4"
              },
              "readonly": {
                "type": "boolean",
                "default": false
              },
              "backup": {
                "type": "boolean",
                "default": true
              },
              "notes": {
                "type": "string",
                "default": ""
              }
            }
          }
        }
      }
    },
    "jobs": {
      "type": "object",
      "properties": {
        "job": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "uuid": {
                "type": "string",
                "format": "uuidv4"
              },
              "enable": {
                "type": "boolean",
                "default": false
              },
              "vmname": {
                "type": "string",
                "default": ""
              },
              "path": {
                "type": "string",
                "default": ""
              },
              "keep": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535,
                "default": 0
              },
              "sendemail": {
                "type": "boolean",
                "default": false
              },
              "emailonerror": {
                "type": "boolean",
                "default": false
              },
              "comment": {
                "type": "string",
                "default": ""
              },
              "execution": {
                "type": "string",
                "enum": [
                  "exactly",
                  "hourly",
                  "daily",
                  "weekly",
                  "monthly",
                  "yearly",
                  "reboot"
                ],
                "default": "exactly"
              },
              "minute": {
                "type": "string",
                "pattern": "^[0-9]|1[0-9]|2[0-9]|3[0-9]|4[0-9]|5[0-9]|[*]$"
              },
              "everynminute": {
                "type": "boolean"
              },
              "hour": {
                "type": "string",
                "pattern": "^[0-9]|1[0-9]|2[0-3]|[*]$"
              },
              "everynhour": {
                "type": "boolean",
                "default": false
              },
              "month": {
                "type": "string",
                "pattern": "^[1-9]|1[0-2]|[*]$"
              },
              "dayofmonth": {
                "type": "string",
                "pattern": "^[1-9]|1[0-9]|2[0-9]|3[0-1]|[*]$"
              },
              "everyndayofmonth": {
                "type": "boolean",
                "default": false
              },
              "dayofweek": {
                "type": "string",
                "pattern": "^[1-7]|[*]$"
              }
            }
          }
        }
      }
    }
  }
}
