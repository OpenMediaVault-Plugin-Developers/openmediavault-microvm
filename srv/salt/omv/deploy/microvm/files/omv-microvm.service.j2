[Unit]
Description=OMV Firecracker microVM (%i)
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/omv-microvm-run %i
ExecStopPost=/usr/sbin/omv-microvm-stop-cleanup %i
ExecStartPost=/usr/sbin/omv-microvm-snapshot-restore-hook %i
Restart=no
StandardOutput=journal
StandardError=journal
# dtach exits 1 on SIGTERM by design, so a normal `systemctl stop` would
# otherwise be reported as failed.
SuccessExitStatus=1

[Install]
WantedBy=multi-user.target
