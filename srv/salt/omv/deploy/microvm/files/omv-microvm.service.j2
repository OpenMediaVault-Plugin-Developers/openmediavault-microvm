[Unit]
Description=OMV Firecracker microVM (%i)
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/omv-microvm-run %i
# Asks the guest to shut down and waits up to the VM's shutdown timeout
# (at most 300s, hence the margin below) before systemd's usual SIGTERM.
ExecStop=/usr/sbin/omv-microvm-shutdown %i
TimeoutStopSec=330
ExecStopPost=/usr/sbin/omv-microvm-stop-cleanup %i
ExecStartPost=/usr/sbin/omv-microvm-snapshot-restore-hook %i
Restart=no
StandardOutput=journal
StandardError=journal
# dtach exits 1 on SIGTERM by design, so a normal `systemctl stop` would
# otherwise be reported as failed.
SuccessExitStatus=1

[Install]
WantedBy=multi-user.target
